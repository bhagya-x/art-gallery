{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/uploads/(.*)$",
      "dest": "/uploads/$1"
    },
    {
      "src": "^/admin/?$",
      "dest": "/api/index.php?path=admin/dashboard.php"
    },
    {
      "src": "^/$",
      "dest": "/api/index.php?path=index.php"
    },
    {
      "src": "^/(.*\\.php)$",
      "dest": "/api/index.php?path=$1"
    },
    {
      "src": "^/([a-zA-Z0-9_-]+)$",
      "dest": "/api/index.php?path=$1.php"
    }
  ]
}
